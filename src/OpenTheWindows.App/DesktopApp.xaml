<Application x:Class="OpenTheWindows.App.DesktopApp"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:OpenTheWindows.App.Converters"
             ThemeMode="System"
             ShutdownMode="OnMainWindowClose">
    <!-- Startup is wired in code-behind (App.xaml.cs) so the main window is
         resolved from the DI container instead of StartupUri. -->
    <Application.Resources>
        <conv:BoolToYesNoConverter x:Key="BoolToYesNo" />
        <conv:RiskToBrushConverter x:Key="RiskToBrush" />
        <conv:NullToVisibilityConverter x:Key="NullToVisibility" />
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </Application.Resources>
</Application>
