<Window x:Class="OpenTheWindows.App.Views.TypedConfirmationDialog"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Confirm"
        SizeToContent="WidthAndHeight"
        Width="460"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        AutomationProperties.AutomationId="TypedConfirm_Window">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="MessageText"
                   Grid.Row="0"
                   TextWrapping="Wrap"
                   MaxWidth="420"
                   AutomationProperties.AutomationId="TypedConfirm_Message" />

        <TextBlock x:Name="InstructionText"
                   Grid.Row="1"
                   TextWrapping="Wrap"
                   MaxWidth="420"
                   Margin="0,12,0,4"
                   FontWeight="SemiBold"
                   AutomationProperties.AutomationId="TypedConfirm_Instruction" />

        <TextBox x:Name="ConfirmationInput"
                 Grid.Row="2"
                 TextChanged="ConfirmationInput_TextChanged"
                 AutomationProperties.AutomationId="TypedConfirm_Input" />

        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <Button x:Name="ConfirmButton"
                    Content="Confirm"
                    IsEnabled="False"
                    IsDefault="True"
                    MinWidth="88"
                    Padding="12,4"
                    Click="ConfirmButton_Click"
                    AutomationProperties.AutomationId="TypedConfirm_Confirm" />
            <Button x:Name="CancelButton"
                    Content="Cancel"
                    IsCancel="True"
                    MinWidth="88"
                    Margin="8,0,0,0"
                    Padding="12,4"
                    AutomationProperties.AutomationId="TypedConfirm_Cancel" />
        </StackPanel>
    </Grid>
</Window>
