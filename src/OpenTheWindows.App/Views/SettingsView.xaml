<UserControl x:Class="OpenTheWindows.App.Views.SettingsView"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:OpenTheWindows.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}"
             d:DesignWidth="640">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="560" HorizontalAlignment="Left">
            <TextBlock Text="Settings" FontSize="24" FontWeight="SemiBold"
                       AutomationProperties.AutomationId="Settings_Title" />

            <TextBlock Text="Applying changes" FontSize="16" FontWeight="SemiBold" Margin="0,20,0,8" />
            <CheckBox Content="Create a System Restore point before applying"
                      Margin="0,4"
                      IsChecked="{Binding Settings.CreateRestorePoint, Mode=TwoWay}"
                      ToolTip="Snapshot the whole system before an apply, so you can roll Windows back if something goes wrong. Recommended."
                      AutomationProperties.AutomationId="Settings_RestorePoint" />
            <CheckBox Content="Restart Explorer automatically when a change needs it"
                      Margin="0,4"
                      IsChecked="{Binding Settings.RestartExplorerAutomatically, Mode=TwoWay}"
                      ToolTip="Some shell tweaks need Explorer restarted to show. Do it automatically instead of asking each time."
                      AutomationProperties.AutomationId="Settings_RestartExplorer" />
            <CheckBox Content="Enterprise mode (hide the consumer-only profiles)"
                      Margin="0,4"
                      IsChecked="{Binding Settings.EnterpriseMode, Mode=TwoWay}"
                      ToolTip="Hide the consumer-only built-in profiles (Home, Gamer) from the Profiles page."
                      AutomationProperties.AutomationId="Settings_EnterpriseMode" />

            <TextBlock Text="Appearance" FontSize="16" FontWeight="SemiBold" Margin="0,20,0,8" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Theme" VerticalAlignment="Center" Margin="0,4" />
                <ComboBox Grid.Row="0" Grid.Column="1" MinWidth="160" Margin="0,4"
                          ItemsSource="{Binding Themes}"
                          SelectedItem="{Binding SelectedTheme, Mode=TwoWay}"
                          ToolTip="Follow the Windows setting, or force Light or Dark."
                          AutomationProperties.Name="Theme"
                          AutomationProperties.AutomationId="Settings_Theme" />

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Language" VerticalAlignment="Center" Margin="0,4" />
                <ComboBox Grid.Row="1" Grid.Column="1" MinWidth="160" Margin="0,4"
                          IsEnabled="False"
                          ItemsSource="{Binding Languages}"
                          SelectedItem="{Binding SelectedLanguage, Mode=OneWay}"
                          ToolTipService.ShowOnDisabled="True"
                          ToolTip="Only English (en-US) ships today. More languages are planned."
                          AutomationProperties.Name="Language"
                          AutomationProperties.AutomationId="Settings_Language" />
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
