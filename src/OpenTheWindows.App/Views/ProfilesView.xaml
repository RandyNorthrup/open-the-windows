<UserControl x:Class="OpenTheWindows.App.Views.ProfilesView"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:OpenTheWindows.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:ProfilesViewModel}"
             d:DesignWidth="820"
             d:DesignHeight="560">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Profiles" FontSize="24" FontWeight="SemiBold"
                   AutomationProperties.AutomationId="Profiles_Title" />

        <DockPanel Grid.Row="1" Margin="0,16,0,12">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Import…" Padding="14,5" Margin="0,0,8,0" Command="{Binding ImportCommand}"
                        AutomationProperties.AutomationId="Profiles_Import" />
                <Button Content="Export…" Padding="14,5" Margin="0,0,8,0" Command="{Binding ExportCommand}"
                        AutomationProperties.AutomationId="Profiles_Export" />
                <Button Content="Review &amp; apply…" Padding="14,5" Command="{Binding ApplySelectedCommand}"
                        AutomationProperties.AutomationId="Profiles_Apply" />
            </StackPanel>
            <TextBlock VerticalAlignment="Center" Opacity="0.75" TextWrapping="Wrap"
                       Text="{Binding Status}" AutomationProperties.AutomationId="Profiles_Status" />
        </DockPanel>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="280" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="360" MinWidth="280" />
            </Grid.ColumnDefinitions>

            <ListBox Grid.Column="0"
                     ItemsSource="{Binding Profiles}"
                     SelectedItem="{Binding SelectedProfile, Mode=TwoWay}"
                     HorizontalContentAlignment="Stretch"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     AutomationProperties.Name="Profiles"
                     AutomationProperties.AutomationId="Profiles_List">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,4">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <Border BorderThickness="1" CornerRadius="4" Padding="5,0" Margin="8,0,0,0"
                                        VerticalAlignment="Center"
                                        BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}">
                                    <TextBlock Text="{Binding SignatureLabel}" FontSize="11" Opacity="0.8" />
                                </Border>
                            </StackPanel>
                            <TextBlock Text="{Binding ScopeLabel}" FontSize="12" Opacity="0.6" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="Transparent" />

            <Border Grid.Column="2" Padding="16" BorderThickness="1" CornerRadius="8"
                    BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}">
                <Grid>
                    <TextBlock Text="Select a profile." Opacity="0.6" VerticalAlignment="Top"
                               Visibility="{Binding SelectedProfile, Converter={StaticResource NullToVisibility}}" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto" DataContext="{Binding SelectedProfile}"
                                  Visibility="{Binding SelectedProfile, Converter={StaticResource NullToVisibility}, ConverterParameter=Invert, RelativeSource={RelativeSource AncestorType=Border}}">
                        <StackPanel>
                            <TextBlock Text="{Binding Name}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Margin="0,6,0,0" Opacity="0.9" />
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Scope" Opacity="0.7" Margin="0,0,16,4" />
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding ScopeLabel}" />
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Signing" Opacity="0.7" Margin="0,0,16,4" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SignatureLabel}" />
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Entries" Opacity="0.7" Margin="0,0,16,4" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding EntryCount}" AutomationProperties.AutomationId="Profiles_EntryCount" />
                            </Grid>
                            <TextBlock Text="{Binding ErrorsText}" TextWrapping="Wrap" Margin="0,12,0,0"
                                       Foreground="{DynamicResource {x:Static SystemColors.HotTrackBrushKey}}"
                                       Visibility="{Binding ErrorsText, Converter={StaticResource NullToVisibility}, ConverterParameter=Invert}" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
