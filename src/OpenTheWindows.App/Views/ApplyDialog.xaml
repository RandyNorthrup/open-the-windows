<Window x:Class="OpenTheWindows.App.Views.ApplyDialog"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:OpenTheWindows.App.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:ApplyFlowViewModel}"
        Title="{Binding Title}"
        Width="660"
        Height="580"
        MinWidth="520"
        MinHeight="420"
        WindowStartupLocation="CenterOwner"
        AutomationProperties.AutomationId="ApplyDialog_Window">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="{Binding Summary}"
                   TextWrapping="Wrap"
                   FontSize="14"
                   Margin="0,0,0,12"
                   AutomationProperties.AutomationId="ApplyDialog_Summary" />

        <!-- Preview -->
        <Grid Grid.Row="1"
              Visibility="{Binding Stage, Converter={StaticResource EnumToVisibility}, ConverterParameter=Preview}">
            <ListBox ItemsSource="{Binding PlanEntries}"
                     HorizontalContentAlignment="Stretch"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling"
                     AutomationProperties.Name="Planned changes"
                     AutomationProperties.AutomationId="ApplyDialog_PlanList">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,4">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding DispositionLabel}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding RiskLabel}" Opacity="0.7" Margin="10,0,0,0" />
                            </StackPanel>
                            <TextBlock Text="{Binding Id}" FontSize="12" Opacity="0.7" />
                            <TextBlock Text="{Binding Note}" FontSize="12" Opacity="0.7" TextWrapping="Wrap"
                                       Visibility="{Binding Note, Converter={StaticResource NullToVisibility}, ConverterParameter=Invert}" />
                            <ItemsControl ItemsSource="{Binding Actions}" Margin="12,2,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

        <!-- Applying -->
        <StackPanel Grid.Row="1"
                    VerticalAlignment="Center"
                    Visibility="{Binding Stage, Converter={StaticResource EnumToVisibility}, ConverterParameter=Applying}">
            <TextBlock Text="Applying changes…" HorizontalAlignment="Center" Margin="0,0,0,12" />
            <ProgressBar IsIndeterminate="True" Height="6" Width="300"
                         AutomationProperties.AutomationId="ApplyDialog_Progress" />
        </StackPanel>

        <!-- Done (Completed or Failed) -->
        <Grid Grid.Row="1"
              Visibility="{Binding Stage, Converter={StaticResource EnumToVisibility}, ConverterParameter='Completed,Failed'}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0"
                       Margin="0,0,0,8"
                       Text="{Binding RestartRequirementLabel, StringFormat=Restart requirement: {0}}"
                       AutomationProperties.AutomationId="ApplyDialog_Restart" />
            <ListBox Grid.Row="1"
                     ItemsSource="{Binding Outcomes}"
                     HorizontalContentAlignment="Stretch"
                     AutomationProperties.Name="Results"
                     AutomationProperties.AutomationId="ApplyDialog_Outcomes">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Margin="0,2">
                            <TextBlock Text="{Binding ResultLabel}" FontWeight="SemiBold" MinWidth="90" />
                            <TextBlock Text="{Binding Id}" Opacity="0.8" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

        <!-- Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <CheckBox Content="Restart Explorer when done"
                      VerticalAlignment="Center"
                      Margin="0,0,16,0"
                      IsChecked="{Binding RestartExplorer, Mode=TwoWay}"
                      Visibility="{Binding ExplorerRestartWouldBeNeeded, Converter={StaticResource BoolToVisibility}}"
                      AutomationProperties.AutomationId="ApplyDialog_RestartCheck" />

            <Button Content="Apply"
                    MinWidth="96"
                    Padding="12,4"
                    Command="{Binding ApplyCommand}"
                    Visibility="{Binding Stage, Converter={StaticResource EnumToVisibility}, ConverterParameter=Preview}"
                    AutomationProperties.AutomationId="ApplyDialog_Apply" />
            <Button Content="Cancel"
                    MinWidth="96"
                    Margin="8,0,0,0"
                    Padding="12,4"
                    IsCancel="True"
                    Click="Close_Click"
                    Visibility="{Binding Stage, Converter={StaticResource EnumToVisibility}, ConverterParameter=Preview}"
                    AutomationProperties.AutomationId="ApplyDialog_Cancel" />

            <Button Content="Restart Explorer now"
                    MinWidth="96"
                    Padding="12,4"
                    Command="{Binding RestartExplorerNowCommand}"
                    Visibility="{Binding ExplorerRestartAvailable, Converter={StaticResource BoolToVisibility}}"
                    AutomationProperties.AutomationId="ApplyDialog_RestartNow" />
            <Button Content="Close"
                    MinWidth="96"
                    Margin="8,0,0,0"
                    Padding="12,4"
                    IsDefault="True"
                    Click="Close_Click"
                    Visibility="{Binding Stage, Converter={StaticResource EnumToVisibility}, ConverterParameter='Completed,Failed'}"
                    AutomationProperties.AutomationId="ApplyDialog_Close" />
        </StackPanel>
    </Grid>
</Window>
