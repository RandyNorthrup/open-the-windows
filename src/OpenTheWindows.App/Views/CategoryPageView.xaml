<UserControl x:Class="OpenTheWindows.App.Views.CategoryPageView"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:OpenTheWindows.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:CategoryPageViewModel}"
             d:DesignWidth="900"
             d:DesignHeight="600">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock VerticalAlignment="Center" Opacity="0.75" Margin="0,0,12,0"
                           Text="{Binding SelectionSummary}"
                           ToolTip="How many entries in this section are ticked for applying."
                           AutomationProperties.AutomationId="{Binding Key, StringFormat={}{0}_SelectionSummary}" />
                <Button Content="Review &amp; apply…"
                        Padding="14,5"
                        Command="{Binding ReviewAndApplyCommand}"
                        ToolTipService.ShowOnDisabled="True"
                        ToolTip="Review the ticked entries and apply them. Nothing changes until you confirm on the next screen. Tick at least one entry to enable this."
                        AutomationProperties.AutomationId="{Binding Key, StringFormat={}{0}_Apply}" />
            </StackPanel>
            <TextBlock Text="{Binding Title}"
                       Style="{StaticResource PageTitleText}"
                       VerticalAlignment="Center"
                       AutomationProperties.AutomationId="{Binding Key, StringFormat={}{0}_Title}" />
        </DockPanel>

        <!-- Toolbar: level dial, search, filters -->
        <Grid Grid.Row="1" Margin="0,16,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="Level" VerticalAlignment="Center" Margin="0,0,8,0" />
            <ComboBox Grid.Column="1"
                      MinWidth="120"
                      ItemsSource="{Binding LevelOptions}"
                      DisplayMemberPath="Label"
                      SelectedValuePath="Value"
                      SelectedValue="{Binding Level, Mode=TwoWay}"
                      ToolTip="Pre-select the entries a profile at this level would apply. Off clears the selection; higher levels include everything below them. You can still tick or untick individual entries afterwards."
                      AutomationProperties.Name="Protection level"
                      AutomationProperties.AutomationId="{Binding Key, StringFormat={}{0}_LevelDial}" />

            <!-- Search with placeholder -->
            <Grid Grid.Column="2" Margin="16,0">
                <TextBox VerticalContentAlignment="Center"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Filter the list by title, id or description. Clearing it shows everything again."
                         AutomationProperties.Name="Search entries"
                         AutomationProperties.AutomationId="{Binding Key, StringFormat={}{0}_Search}" />
                <TextBlock Text="Search titles, ids…"
                           Margin="10,0,0,0"
                           VerticalAlignment="Center"
                           Opacity="0.5"
                           TextTrimming="CharacterEllipsis"
                           IsHitTestVisible="False">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SearchText}" Value="">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>

            <ComboBox Grid.Column="3"
                      MinWidth="110"
                      Margin="0,0,12,0"
                      ItemsSource="{Binding RiskFilterOptions}"
                      DisplayMemberPath="Label"
                      SelectedValuePath="Value"
                      SelectedValue="{Binding RiskFilter, Mode=TwoWay}"
                      ToolTip="Show only entries at the chosen risk level (Safe, Caution, Advanced or Breaking)."
                      AutomationProperties.Name="Filter by risk"
                      AutomationProperties.AutomationId="{Binding Key, StringFormat={}{0}_RiskFilter}" />

            <ComboBox Grid.Column="4"
                      MinWidth="150"
                      Margin="0,0,12,0"
                      Visibility="{Binding ShowBaselineFilter, Converter={StaticResource BoolToVisibility}}"
                      ItemsSource="{Binding BaselineFilterOptions}"
                      DisplayMemberPath="Label"
                      SelectedValuePath="Value"
                      SelectedValue="{Binding BaselineFilter, Mode=TwoWay}"
                      ToolTip="Show only entries that map to a control in the chosen security baseline (STIG, CIS or Microsoft)."
                      AutomationProperties.Name="Filter by baseline"
                      AutomationProperties.AutomationId="{Binding Key, StringFormat={}{0}_BaselineFilter}" />

        </Grid>

        <!-- Body: entry list + detail pane -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.2*" MinWidth="200" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="*" MinWidth="200" />
            </Grid.ColumnDefinitions>

            <ListBox Grid.Column="0"
                     ItemsSource="{Binding Items}"
                     SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                     HorizontalContentAlignment="Stretch"
                     Padding="0,0,6,0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling"
                     ScrollViewer.CanContentScroll="True"
                     AutomationProperties.Name="Tweak entries"
                     AutomationProperties.AutomationId="{Binding Key, StringFormat={}{0}_List}">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="6,2" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <CheckBox Grid.Column="0"
                                      VerticalAlignment="Top"
                                      Margin="0,1,12,0"
                                      IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                      ToolTip="Tick to include this entry when you Review &amp; apply."
                                      AutomationProperties.Name="{Binding Title}" />
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <WrapPanel Margin="0,4,0,0">
                                    <Border BorderBrush="{Binding Risk, Converter={StaticResource RiskToBrush}}"
                                            BorderThickness="1" CornerRadius="4" Padding="5,0" Margin="0,0,6,0"
                                            VerticalAlignment="Center"
                                            ToolTip="How risky this change is. Caution and above can have side effects — the details pane lists them.">
                                        <TextBlock Text="{Binding RiskLabel}" FontSize="11"
                                                   Foreground="{Binding Risk, Converter={StaticResource RiskToBrush}}" />
                                    </Border>
                                    <Border BorderThickness="1" CornerRadius="4" Padding="5,0" Margin="0,0,6,0"
                                            VerticalAlignment="Center"
                                            BorderBrush="{DynamicResource CardBorderBrush}"
                                            Visibility="{Binding RequiresRestart, Converter={StaticResource BoolToVisibility}}"
                                            ToolTip="This change only takes full effect after the restart shown here.">
                                        <TextBlock Text="{Binding RestartLabel}" FontSize="11" Opacity="0.8" />
                                    </Border>
                                </WrapPanel>
                                <TextBlock Text="{Binding IdText}" FontSize="11" Opacity="0.55" Margin="0,4,0,0" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Shown in place of the list when nothing matches the search / filters. -->
            <TextBlock Grid.Column="0"
                       Text="{Binding EmptyMessage}"
                       Style="{StaticResource MutedText}"
                       VerticalAlignment="Top"
                       Margin="6,10,12,0"
                       Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}"
                       AutomationProperties.AutomationId="{Binding Key, StringFormat={}{0}_Empty}" />

            <!-- Detail pane -->
            <Border Grid.Column="2"
                    Padding="16"
                    BorderThickness="1"
                    CornerRadius="8"
                    BorderBrush="{DynamicResource CardBorderBrush}">
                <Grid>
                    <TextBlock Text="Select an entry to see what it changes, why, and its sources."
                               Style="{StaticResource MutedText}"
                               VerticalAlignment="Top"
                               Visibility="{Binding DataContext.SelectedItem, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource NullToVisibility}}" />

                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  Visibility="{Binding DataContext.SelectedItem, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource NullToVisibility}, ConverterParameter=Invert}"
                                  DataContext="{Binding SelectedItem}"
                                  AutomationProperties.AutomationId="{Binding DataContext.Key, RelativeSource={RelativeSource AncestorType=UserControl}, StringFormat={}{0}_Detail}">
                        <StackPanel Margin="0,0,6,0">
                            <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding IdText}" FontSize="12" Opacity="0.6" Margin="0,2,0,0" TextWrapping="Wrap" />
                            <WrapPanel Margin="0,10,0,0">
                                <TextBlock Text="{Binding RiskLabel}" Margin="0,0,12,0" />
                                <TextBlock Text="{Binding RestartLabel}" Opacity="0.8" />
                            </WrapPanel>

                            <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Margin="0,12,0,0" />

                            <TextBlock Text="Why" FontWeight="SemiBold" Margin="0,14,0,2" />
                            <TextBlock Text="{Binding Rationale}" TextWrapping="Wrap" Opacity="0.9" />

                            <StackPanel Visibility="{Binding HasSideEffects, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="Side effects" FontWeight="SemiBold" Margin="0,14,0,2" />
                                <ItemsControl ItemsSource="{Binding SideEffects}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,0,0,2" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <TextBlock Text="What it does" FontWeight="SemiBold" Margin="0,14,0,2" />
                            <ItemsControl ItemsSource="{Binding ActionSummaries}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12" Margin="0,0,0,2" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="Sources" FontWeight="SemiBold" Margin="0,14,0,2" />
                            <ItemsControl ItemsSource="{Binding Sources}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding Mode=OneWay}" IsReadOnly="True" BorderThickness="0"
                                                 Background="Transparent" Padding="0" FontSize="12" TextWrapping="Wrap" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
