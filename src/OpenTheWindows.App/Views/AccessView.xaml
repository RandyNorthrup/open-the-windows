<UserControl x:Class="OpenTheWindows.App.Views.AccessView"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:OpenTheWindows.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:AccessViewModel}"
             d:DesignWidth="900"
             d:DesignHeight="560">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="App access" Style="{StaticResource PageTitleText}"
                   AutomationProperties.AutomationId="Access_Title" />
        <TextBlock Grid.Row="1" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,6,0,0"
                   Text="Which apps used your camera, microphone or location, and when — from the last-used times Windows records for each app. Read-only." />

        <DockPanel Grid.Row="2" Margin="0,16,0,10">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <CheckBox Content="Show _every capability" VerticalAlignment="Center" Margin="0,0,12,0"
                          IsChecked="{Binding ShowAll, Mode=TwoWay}"
                          ToolTip="Also list contacts, calendar, documents and the other capabilities Windows records."
                          AutomationProperties.AutomationId="Access_ShowAll" />
                <Button Content="Re_fresh" Padding="14,5" Command="{Binding RefreshCommand}"
                        ToolTip="Read the recorded use again."
                        AutomationProperties.AutomationId="Access_Refresh" />
            </StackPanel>
            <TextBlock Text="{Binding Status}" Style="{StaticResource MutedText}" VerticalAlignment="Center"
                       AutomationProperties.LiveSetting="Polite"
                       AutomationProperties.AutomationId="Access_Status" />
        </DockPanel>

        <ListBox Grid.Row="3"
                 ItemsSource="{Binding Uses}"
                 HorizontalContentAlignment="Stretch"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 AutomationProperties.Name="Recorded use"
                 AutomationProperties.AutomationId="Access_List">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding CapabilityLabel}" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="1" Text="{Binding WhenLabel}" />
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="{Binding App}" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding KindLabel}" FontSize="11" Opacity="0.6" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>
