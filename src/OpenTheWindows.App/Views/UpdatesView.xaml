<UserControl x:Class="OpenTheWindows.App.Views.UpdatesView"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:OpenTheWindows.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:UpdatesViewModel}"
             d:DesignWidth="760"
             d:DesignHeight="560">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock Text="Windows Update" FontSize="24" FontWeight="SemiBold"
                       AutomationProperties.AutomationId="Updates_Title" />

            <Border Margin="0,12,0,0" Padding="12,8" CornerRadius="6"
                    Background="{DynamicResource InfoBackgroundBrush}"
                    Visibility="{Binding IsManaged, Converter={StaticResource BoolToVisibility}}"
                    AutomationProperties.AutomationId="Updates_ManagedBanner">
                <TextBlock TextWrapping="Wrap"
                           Text="Windows Update is managed by your organisation. Pause and resume are read-only here." />
            </Border>

            <Border Margin="0,16,0,0" Padding="16" BorderThickness="1" CornerRadius="8"
                    BorderBrush="{DynamicResource CardBorderBrush}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Version" Opacity="0.7" Margin="0,0,16,6" />
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding CurrentVersion}" AutomationProperties.AutomationId="Updates_Version" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="End of servicing" Opacity="0.7" Margin="0,0,16,6" />
                    <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal">
                        <TextBlock Text="{Binding EndOfService}" AutomationProperties.AutomationId="Updates_Eos" />
                        <TextBlock Text="  · approaching end of servicing" Margin="6,0,0,0"
                                   Foreground="{DynamicResource LinkBrush}"
                                   Visibility="{Binding EndOfServiceWarning, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Pause" Opacity="0.7" Margin="0,0,16,6" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding PauseState}" AutomationProperties.AutomationId="Updates_PauseState" />

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Pinned release" Opacity="0.7" Margin="0,0,16,6" />
                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding TargetRelease}" />
                </Grid>
            </Border>

            <TextBlock Text="Pause updates" FontSize="16" FontWeight="SemiBold" Margin="0,20,0,8" />
            <WrapPanel>
                <ItemsControl ItemsSource="{Binding PausePresets}"
                              AutomationProperties.AutomationId="Updates_Presets">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Content="{Binding StringFormat={}{0} days}"
                                    Padding="14,5" Margin="0,0,8,0"
                                    Command="{Binding DataContext.PauseCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}"
                                    ToolTipService.ShowOnDisabled="True"
                                    ToolTip="{Binding StringFormat=Pause Windows Update for {0} days. Disabled when updates are managed by your organisation.}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Content="Resume now" Padding="14,5" Margin="8,0,0,0"
                        Command="{Binding ResumeCommand}"
                        ToolTipService.ShowOnDisabled="True"
                        ToolTip="Resume Windows Update now and clear every active pause. Enabled only while updates are paused."
                        AutomationProperties.AutomationId="Updates_Resume" />
            </WrapPanel>

            <TextBlock Text="Extended pause (beyond the supported maximum)" FontSize="16" FontWeight="SemiBold" Margin="0,20,0,8" />
            <StackPanel Orientation="Horizontal">
                <ComboBox MinWidth="110" VerticalContentAlignment="Center"
                          ItemsSource="{Binding ExtendedOptions}"
                          SelectedItem="{Binding ExtendedDays, Mode=TwoWay}"
                          ToolTip="Choose how many days to pause beyond the 35-day Windows maximum."
                          AutomationProperties.Name="Extended pause days"
                          AutomationProperties.AutomationId="Updates_ExtendedDays" />
                <Button Content="Pause (extended)…" Padding="14,5" Margin="8,0,0,0"
                        Command="{Binding ExtendedPauseCommand}"
                        ToolTipService.ShowOnDisabled="True"
                        ToolTip="Pause beyond the supported maximum. You are warned first — no security updates arrive for the whole period. Defender signature updates still flow."
                        AutomationProperties.AutomationId="Updates_ExtendedPause" />
            </StackPanel>

            <Button Content="Refresh status" Padding="14,5" Margin="0,20,0,0" HorizontalAlignment="Left"
                    Command="{Binding RefreshCommand}"
                    ToolTip="Read the current update, pause and end-of-servicing status from this PC. Nothing is loaded until you do this."
                    AutomationProperties.AutomationId="Updates_Refresh" />

            <TextBlock Text="Hide a specific update" FontSize="16" FontWeight="SemiBold" Margin="0,20,0,8" />
            <TextBlock TextWrapping="Wrap" Margin="0,0,0,8" Opacity="0.75"
                       Text="Hides one knowledge-base article the Windows Update Agent has already discovered. Reversible. The agent may contact Microsoft Update to resolve the KB." />
            <StackPanel Orientation="Horizontal">
                <TextBox MinWidth="160" Padding="6,4"
                         Text="{Binding KnowledgeBaseId, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Knowledge-base id, for example KB5063878."
                         AutomationProperties.Name="Knowledge-base id"
                         AutomationProperties.AutomationId="Updates_Kb" />
                <Button Content="Hide" Padding="14,5" Margin="8,0,0,0"
                        Command="{Binding HideCommand}"
                        ToolTipService.ShowOnDisabled="True"
                        ToolTip="Hide this KB. Disabled when updates are managed or the id is empty."
                        AutomationProperties.AutomationId="Updates_Hide" />
                <Button Content="Unhide" Padding="14,5" Margin="8,0,0,0"
                        Command="{Binding UnhideCommand}"
                        ToolTipService.ShowOnDisabled="True"
                        ToolTip="Clear the hidden flag on this KB."
                        AutomationProperties.AutomationId="Updates_Unhide" />
                <Button Content="Refresh hidden" Padding="14,5" Margin="8,0,0,0"
                        Command="{Binding RefreshHiddenCommand}"
                        ToolTip="List updates the agent currently has hidden."
                        AutomationProperties.AutomationId="Updates_RefreshHidden" />
            </StackPanel>
            <TextBlock Text="{Binding HideStatus}" Margin="0,8,0,0" TextWrapping="Wrap"
                       AutomationProperties.AutomationId="Updates_HideStatus" />
            <TextBlock Text="{Binding HiddenList}" Margin="0,8,0,0" TextWrapping="Wrap"
                       AutomationProperties.AutomationId="Updates_HiddenList" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
