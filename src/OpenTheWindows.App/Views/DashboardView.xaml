<UserControl x:Class="OpenTheWindows.App.Views.DashboardView"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:OpenTheWindows.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:DashboardViewModel}"
             d:DesignWidth="640">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
            <TextBlock Text="System check"
                       Style="{StaticResource SectionHeaderText}"
                       Margin="0,0,0,8" />

            <Border Style="{StaticResource Card}"
                    DataContext="{Binding Doctor}"
                    HorizontalAlignment="Stretch">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Operating system" Style="{StaticResource FieldLabelText}" />
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding OperatingSystemSummary}" TextWrapping="Wrap" AutomationProperties.AutomationId="Dashboard_OsText" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Edition" Style="{StaticResource FieldLabelText}" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding EditionSummary}" AutomationProperties.AutomationId="Dashboard_EditionText" />

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Running as" Style="{StaticResource FieldLabelText}" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding UserSummary}"
                               ToolTip="Applying changes needs an elevated (administrator) session."
                               AutomationProperties.AutomationId="Dashboard_UserText" />

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Status" Style="{StaticResource FieldLabelText}" />
                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Status}" AutomationProperties.AutomationId="Dashboard_StatusText" />

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Can apply changes" Style="{StaticResource FieldLabelText}" />
                    <TextBlock Grid.Row="4" Grid.Column="1"
                               Text="{Binding CanApply, Converter={StaticResource BoolToYesNo}}"
                               ToolTip="Whether this session can write changes (needs administrator rights on a supported build)."
                               AutomationProperties.AutomationId="Dashboard_CanApplyText" />

                    <ItemsControl Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2"
                                  ItemsSource="{Binding Notes}"
                                  Margin="0,8,0,0"
                                  AutomationProperties.AutomationId="Dashboard_NotesList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,0,0,4" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Button Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2"
                            Content="Re-check"
                            Command="{Binding RefreshCommand}"
                            HorizontalAlignment="Left"
                            Margin="0,12,0,0"
                            Padding="16,6"
                            ToolTip="Read this PC's Windows version, edition and elevation again."
                            AutomationProperties.AutomationId="Dashboard_RefreshButton" />
                </Grid>
            </Border>

            <TextBlock Text="Security baselines" Style="{StaticResource SectionHeaderText}" Margin="0,24,0,8" />
            <Border Style="{StaticResource Card}" HorizontalAlignment="Stretch">
                <StackPanel>
                    <TextBlock Text="{Binding AuditStatus}"
                               Style="{StaticResource MutedText}"
                               Margin="0,0,0,8"
                               AutomationProperties.AutomationId="Dashboard_AuditStatus" />
                    <ItemsControl ItemsSource="{Binding BaselineScores}"
                                  AutomationProperties.AutomationId="Dashboard_BaselineScores">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        <ProgressBar Minimum="0" Maximum="100" Value="{Binding Score, Mode=OneWay}"
                                                     Height="8" Margin="0,4"
                                                     ToolTip="Percentage of this baseline's checks this PC currently passes." />
                                        <TextBlock Text="{Binding Summary}" FontSize="12" Opacity="0.7" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding ScoreLabel}"
                                               FontSize="20"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Content="Score this machine"
                            Command="{Binding RefreshScoresCommand}"
                            HorizontalAlignment="Left"
                            Margin="0,4,0,0"
                            Padding="16,6"
                            ToolTip="Audit this PC against the built-in security baselines. Read-only — it changes nothing."
                            AutomationProperties.AutomationId="Dashboard_ReScoreButton" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
