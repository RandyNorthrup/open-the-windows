<UserControl x:Class="OpenTheWindows.App.Views.AboutView"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:OpenTheWindows.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:AboutViewModel}"
             d:DesignWidth="640">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
        <StackPanel Orientation="Horizontal">
            <Image Source="{StaticResource OtwMark}"
                   Width="56" Height="56"
                   VerticalAlignment="Center"
                   RenderOptions.BitmapScalingMode="HighQuality"
                   AutomationProperties.Name="Open the Windows logo" />
            <TextBlock Text="{Binding ProductName, Mode=OneTime}"
                       Style="{StaticResource PageTitleText}"
                       VerticalAlignment="Center"
                       Margin="14,0,0,0"
                       AutomationProperties.AutomationId="About_ProductName" />
        </StackPanel>

        <Grid Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Version" Margin="0,0,16,6" Opacity="0.75" />
            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Version, Mode=OneTime}"
                       AutomationProperties.AutomationId="About_Version" />

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Licence" Margin="0,0,16,6" Opacity="0.75" />
            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding License, Mode=OneTime}"
                       AutomationProperties.AutomationId="About_License" />

            <TextBlock Grid.Row="2" Grid.Column="0" Text="Homepage" Margin="0,0,16,6" Opacity="0.75" />
            <TextBox Grid.Row="2" Grid.Column="1"
                     Text="{Binding Homepage, Mode=OneWay}"
                     IsReadOnly="True"
                     BorderThickness="0"
                     Background="Transparent"
                     Padding="0"
                     ToolTip="Project source, issues and releases on GitHub. Select the text to copy it."
                     AutomationProperties.Name="Homepage URL"
                     AutomationProperties.AutomationId="About_Homepage" />
        </Grid>

        <TextBlock Text="{Binding Disclaimer, Mode=OneTime}"
                   Margin="0,24,0,0"
                   Style="{StaticResource MutedText}"
                   AutomationProperties.AutomationId="About_Disclaimer" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
