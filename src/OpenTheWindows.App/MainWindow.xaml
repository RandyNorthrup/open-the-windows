<Window x:Class="OpenTheWindows.App.MainWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:OpenTheWindows.App.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainWindowViewModel}"
        Title="{Binding WindowTitle, Mode=OneTime}"
        Width="960"
        Height="640"
        MinWidth="720"
        MinHeight="480"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0"
                   Text="{Binding Title, Mode=OneTime}"
                   FontSize="28"
                   FontWeight="SemiBold"
                   AutomationProperties.AutomationId="TitleText" />

        <!-- Section heading -->
        <TextBlock Grid.Row="1"
                   Text="System check"
                   FontSize="18"
                   FontWeight="SemiBold"
                   Margin="0,24,0,8" />

        <!-- Doctor report -->
        <Border Grid.Row="2"
                Padding="16"
                CornerRadius="8"
                BorderThickness="1"
                BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                DataContext="{Binding Doctor}"
                VerticalAlignment="Top">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Operating system" Margin="0,0,16,6" Opacity="0.75" />
                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding OperatingSystemSummary}" AutomationProperties.AutomationId="OsText" />

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Edition" Margin="0,0,16,6" Opacity="0.75" />
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding EditionSummary}" AutomationProperties.AutomationId="EditionText" />

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Running as" Margin="0,0,16,6" Opacity="0.75" />
                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding UserSummary}" AutomationProperties.AutomationId="UserText" />

                <TextBlock Grid.Row="3" Grid.Column="0" Text="Status" Margin="0,0,16,6" Opacity="0.75" />
                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Status}" AutomationProperties.AutomationId="StatusText" />

                <TextBlock Grid.Row="4" Grid.Column="0" Text="Can apply changes" Margin="0,0,16,6" Opacity="0.75" />
                <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding CanApply}" AutomationProperties.AutomationId="CanApplyText" />

                <ItemsControl Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2"
                              ItemsSource="{Binding Notes}"
                              Margin="0,8,0,0"
                              AutomationProperties.AutomationId="NotesList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,0,0,4" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Button Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2"
                        Content="Re-check"
                        Command="{Binding RefreshCommand}"
                        HorizontalAlignment="Left"
                        Margin="0,12,0,0"
                        Padding="16,6"
                        AutomationProperties.AutomationId="RefreshButton" />
            </Grid>
        </Border>

        <!-- Footer -->
        <TextBlock Grid.Row="3"
                   Text="{Binding Version, Mode=OneTime, StringFormat=Version {0}}"
                   Opacity="0.6"
                   Margin="0,16,0,0"
                   AutomationProperties.AutomationId="VersionText" />
    </Grid>
</Window>
