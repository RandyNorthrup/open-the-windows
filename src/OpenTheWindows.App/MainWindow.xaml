<Window x:Class="OpenTheWindows.App.MainWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:OpenTheWindows.App.ViewModels"
        xmlns:views="clr-namespace:OpenTheWindows.App.Views"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainWindowViewModel}"
        Title="{x:Static vm:MainWindowViewModel.WindowTitle}"
        Width="960"
        Height="640"
        MinWidth="720"
        MinHeight="480"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:CategoryPageViewModel}">
            <views:CategoryPageView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:HistoryViewModel}">
            <views:HistoryView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ProfilesViewModel}">
            <views:ProfilesView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:UpdatesViewModel}">
            <views:UpdatesView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AboutViewModel}">
            <views:AboutView />
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Navigation rail -->
        <Border Grid.Column="0"
                Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="16,16,16,8">
                    <TextBlock Text="{x:Static vm:MainWindowViewModel.Title}"
                               FontSize="20"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"
                               AutomationProperties.AutomationId="Shell_ProductTitle" />
                </StackPanel>

                <TextBlock DockPanel.Dock="Bottom"
                           Text="{x:Static vm:MainWindowViewModel.Version}"
                           Opacity="0.6"
                           Margin="16,8,16,16"
                           ToolTip="Installed version of Open the Windows"
                           AutomationProperties.AutomationId="Shell_Version" />

                <ListBox ItemsSource="{Binding NavigationItems}"
                         SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                         BorderThickness="0"
                         Background="Transparent"
                         Margin="8,0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         AutomationProperties.Name="Pages"
                         AutomationProperties.AutomationId="Shell_Navigation">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="12,8" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
                            <Setter Property="AutomationProperties.AutomationId" Value="{Binding Key, StringFormat=Nav_{0}}" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Title}" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Page host. No scroll viewer here: each page owns its own scrolling,
             so there is never a second, detached scrollbar over a page that
             already scrolls its own content. -->
        <DockPanel Grid.Column="1">
            <Grid DockPanel.Dock="Top" Margin="24,16,24,0">
                <Button HorizontalAlignment="Left"
                        Content="◀  Back"
                        Padding="12,5"
                        Command="{Binding BackCommand}"
                        ToolTipService.ShowOnDisabled="True"
                        ToolTip="Return to the page you were on before this one"
                        AutomationProperties.Name="Back"
                        AutomationProperties.AutomationId="Shell_Back" />
            </Grid>
            <ContentControl Content="{Binding CurrentPage}"
                            Margin="24,12,24,24"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch"
                            AutomationProperties.Name="Current page"
                            AutomationProperties.AutomationId="Shell_Content" />
        </DockPanel>
    </Grid>
</Window>
