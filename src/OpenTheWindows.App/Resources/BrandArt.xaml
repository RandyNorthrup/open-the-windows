<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        The Open the Windows app mark: one window opening outward with a shield on the open
        sash (privacy and protection), on a navy-to-azure tile. 256 px, scaled down with
        high-quality filtering where it is shown. Built from assets/open-the-windows-icon.png,
        as is the exe / taskbar icon Resources/OpenTheWindows.ico.
    -->
    <BitmapImage x:Key="OtwMark" UriSource="/Resources/OpenTheWindowsMark.png" CacheOption="OnLoad" />
</ResourceDictionary>
