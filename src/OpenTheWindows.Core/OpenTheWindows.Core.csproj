<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Core: domain model, catalogue, engine, journal, abstractions.
    Deliberately targets plain net10.0 with NO Windows API references so it is
    unit-testable anywhere and the OS boundary stays in OpenTheWindows.Windows.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>OpenTheWindows.Core</RootNamespace>
    <AssemblyName>OpenTheWindows.Core</AssemblyName>
    <IsPackable>false</IsPackable>
    <IsTrimmable>true</IsTrimmable>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="JsonSchema.Net" />
  </ItemGroup>

  <!-- The built-in catalogue and its schema are embedded so the engine works
       offline and the shipped catalogue is tamper-evident (same hash as the repo).
       Logical names use forward slashes: catalog/<category>/<file>.json.
       eos.json is reference data, not a tweak document, so it is embedded under a
       separate logical name and excluded from the catalogue glob that the loader
       parses against the tweak schema. Profiles and baselines are configuration
       documents, not tweak documents, so they are embedded under separate
       "profiles/" and "baselines/" logical prefixes and excluded from the
       catalogue glob; their schemas stay under catalog/schema/ where the
       catalogue loader already skips them. -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\catalog\**\*.json" Exclude="..\..\catalog\updates\eos.json;..\..\catalog\profiles\**\*.json;..\..\catalog\baselines\**\*.json" LogicalName="catalog/%(RecursiveDir)%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\..\catalog\updates\eos.json" LogicalName="data/eos.json" />
    <EmbeddedResource Include="..\..\catalog\profiles\*.json" LogicalName="profiles/%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\..\catalog\baselines\*.json" LogicalName="baselines/%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="OpenTheWindows.Core.Tests" />
  </ItemGroup>

</Project>
