<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Core: domain model, catalogue, engine, journal, abstractions.
    Deliberately targets plain net10.0 with NO Windows API references so it is
    unit-testable anywhere and the OS boundary stays in OpenTheWindows.Windows.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>OpenTheWindows.Core</RootNamespace>
    <AssemblyName>OpenTheWindows.Core</AssemblyName>
    <IsPackable>false</IsPackable>
    <IsTrimmable>true</IsTrimmable>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="JsonSchema.Net" />
  </ItemGroup>

  <!-- The built-in catalogue and its schema are embedded so the engine works
       offline and the shipped catalogue is tamper-evident (same hash as the repo).
       Logical names use forward slashes: catalog/<category>/<file>.json -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\catalog\**\*.json" LogicalName="catalog/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="OpenTheWindows.Core.Tests" />
  </ItemGroup>

</Project>
