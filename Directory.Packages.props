<!--
  Open The Windows — Central Package Management.

  Every NuGet version in the repository is pinned HERE and only here; project
  files reference packages without a Version attribute. Versions were verified
  against nuget.org on 2026-08-16 (see docs/research/06-stack-and-tooling-verification.md
  and PLAN.md "Version decisions"). Bump deliberately, one line per package.

  GlobalPackageReference items are analyzers applied to EVERY project.
-->
<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <!-- ─── Analyzers applied to every project ────────────────────────────── -->
  <ItemGroup>
    <!-- Roslynator: ~500 additional C# analyzers/refactorings. -->
    <GlobalPackageReference Include="Roslynator.Analyzers" Version="4.16.1" />
    <!-- SonarAnalyzer: bugs, vulnerabilities, code smells (incl. S125 commented-out code, S109 magic numbers). -->
    <GlobalPackageReference Include="SonarAnalyzer.CSharp" Version="10.32.0.713" />
    <!-- Meziantou: culture, async, string, IDisposable, method-length and naming rules. -->
    <GlobalPackageReference Include="Meziantou.Analyzer" Version="3.0.159" />
    <!-- IDisposable lifetime correctness (registry keys, handles, WMI objects). -->
    <GlobalPackageReference Include="IDisposableAnalyzers" Version="4.0.8" />
    <!-- Threading/async hygiene (VSTHRD*): no sync-over-async, no async void, ConfigureAwait. -->
    <GlobalPackageReference Include="Microsoft.VisualStudio.Threading.Analyzers" Version="18.7.23" />
    <!-- Banned APIs: BannedSymbols.txt forbids Registry.CurrentUser in Core/engine code, Process.Start("powershell") etc. -->
    <GlobalPackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="5.6.0" />
    <!-- Unused ProjectReference / PackageReference detection (dead-dependency gate). -->
    <GlobalPackageReference Include="ReferenceTrimmer" Version="3.5.9" />
    <!-- Reproducible build defaults (Deterministic, SourceLink, embedded untracked sources). -->
    <GlobalPackageReference Include="DotNet.ReproducibleBuilds" Version="2.0.5" />
  </ItemGroup>

  <!-- ─── Product packages ──────────────────────────────────────────────── -->
  <ItemGroup>
    <!-- CLI parsing (2.0 GA line). -->
    <PackageVersion Include="System.CommandLine" Version="2.0.11" />
    <!-- MVVM source generators for the WPF app. -->
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <!-- Dependency injection container shared by CLI and App. -->
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.11" />
    <!-- JSON Schema (draft 2020-12) validation of catalogue files; MIT, AOT-friendly. -->
    <PackageVersion Include="JsonSchema.Net" Version="9.4.0" />
    <!-- Service control-manager reads (start type, run state) for OpenTheWindows.Windows only. -->
    <PackageVersion Include="System.ServiceProcess.ServiceController" Version="10.0.11" />
    <!-- Task Scheduler 2.0 wrapper (read-only enabled-state reads) for OpenTheWindows.Windows only; MIT. -->
    <PackageVersion Include="TaskScheduler" Version="2.12.2" />
    <!-- WMI (System.Management) for read-only Win32_OptionalFeature and Defender MSFT_MpPreference reads; Windows only. -->
    <PackageVersion Include="System.Management" Version="10.0.11" />
    <!-- Windows Event Log source (OpenTheWindows/OTW) for the audit trail; Windows only. -->
    <PackageVersion Include="System.Diagnostics.EventLog" Version="10.0.11" />
  </ItemGroup>

  <!-- ─── Test packages ─────────────────────────────────────────────────── -->
  <ItemGroup>
    <!-- xunit.v3 runs on Microsoft.Testing.Platform (MTP); global.json opts `dotnet test` in.
         VSTest packages (Microsoft.NET.Test.Sdk, xunit.runner.visualstudio) are NOT used:
         the .NET 10 SDK refuses VSTest mode for MTP projects. -->
    <PackageVersion Include="xunit.v3" Version="4.0.0" />
    <!-- Code coverage collector for MTP (dotnet test with the coverage switch). Thresholds are
         enforced by ReportGenerator (dotnet tool) in build/quality.ps1. -->
    <PackageVersion Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.10.0" />
  </ItemGroup>

</Project>
