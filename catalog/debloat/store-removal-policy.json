          "default": null,
          "valueKind": "Policy"
        }
      ],
      "requires": "SignOut",
      "dependsOn": [],
      "conflictsWith": [],
      "managedBy": {
        "policyCsp": "ApplicationManagement/RemoveDefaultMicrosoftStorePackages",
        "groupPolicyPath": "Computer Configuration\\Administrative Templates\\Windows Components\\App Package Deployment\\Remove Default Microsoft Store packages from the system"
      },
      "sideEffects": [
        "Selected inbox apps are uninstalled at the next sign-in and blocked from Store reinstall while the policy stays on. Local app data for those packages is removed. Calculator, Notepad, Paint, Photos, Camera and Terminal are not in this list."
      ],
      "sources": [
        "https://learn.microsoft.com/en-us/windows/configuration/policy-based-inbox-app-removal/policy-based-inbox-app-removal",
        "https://learn.microsoft.com/en-us/windows/client-management/mdm/policy-csp-applicationmanagement"
      ],
      "verifiedOn": [],
      "tags": ["debloat", "appx", "policy", "enterprise"]
    }
