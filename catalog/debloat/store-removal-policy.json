{
  "$schema": "../schema/tweak.schema.json",
  "entries": [
    {
      "id": "debloat.policy.remove-inbox-store-packages",
      "title": "Persist inbox Store-app removal (official policy)",
      "description": "Enables RemoveDefaultMicrosoftStorePackages for consumer inbox apps (Clipchamp, Copilot, Bing News/Weather, Solitaire, Feedback Hub, Office Hub, Teams, Xbox client/overlay/identity/TCUI). While the policy is on, those apps stay uninstalled and the Store cannot put them back. Enterprise and Education, 24H2+.",
      "rationale": "Appx removal is immediate but Windows re-offers packages after feature updates. This is Microsoft's supported persistence policy. It does not remove Calculator, Notepad, Paint, Photos, Camera or Terminal. Removals apply at sign-in, not mid-session. Complements the individual Appx entries.",
      "category": "Debloat",
      "level": "Strict",
      "risk": "Caution",
      "scope": "Machine",
      "status": "Draft",
      "appliesTo": {
        "editions": ["Enterprise", "Education"],
        "minBuild": 26100,
        "maxBuild": null,
        "architectures": []
      },
      "actions": [
        {
          "kind": "Registry",
          "hive": "LocalMachine",
          "path": "SOFTWARE\\Policies\\Microsoft\\Windows\\Appx\\RemoveDefaultMicrosoftStorePackages",
          "name": "Enabled",
          "type": "Dword",
          "value": 1,
          "default": null,
          "valueKind": "Policy"
        },
        {
          "kind": "Registry",
          "hive": "LocalMachine",
          "path": "SOFTWARE\\Policies\\Microsoft\\Windows\\Appx\\RemoveDefaultMicrosoftStorePackages",
          "name": "Clipchamp",
          "type": "Dword",
          "value": 1,
          "default": null,
          "valueKind": "Policy"
        },
        {
          "kind": "Registry",
          "hive": "LocalMachine",
          "path": "SOFTWARE\\Policies\\Microsoft\\Windows\\Appx\\RemoveDefaultMicrosoftStorePackages",
          "name": "Copilot",
          "type": "Dword",
          "value": 1,
          "default": null,
          "valueKind": "Policy"
        },
        {
          "kind": "Registry",
          "hive": "LocalMachine",
          "path": "SOFTWARE\\Policies\\Microsoft\\Windows\\Appx\\RemoveDefaultMicrosoftStorePackages",
          "name": "BingNews",
          "type": "Dword",
          "value": 1,
          "default": null,
          "valueKind": "Policy"
        },
        {
          "kind": "Registry",
          "hive": "LocalMachine",
          "path": "SOFTWARE\\Policies\\Microsoft\\Windows\\Appx\\RemoveDefaultMicrosoftStorePackages",
          "name": "BingWeather",
          "type": "Dword",
          "value": 1,
          "default": null,
          "valueKind": "Policy"
        },
        {
          "kind": "Registry",
          "hive": "LocalMachine",
          "path": "SOFTWARE\\Policies\\Microsoft\\Windows\\Appx\\RemoveDefaultMicrosoftStorePackages",
          "name": "MicrosoftSolitaireCollection",
          "type": "Dword",
          "value": 1,
          "default": null,
          "valueKind": "Policy"
        },
        {
          "kind": "Registry",
          "hive": "LocalMachine",
          "path": "SOFTWARE\\Policies\\Microsoft\\Windows\\Appx\\RemoveDefaultMicrosoftStorePackages",
          "name": "WindowsFeedbackHub",
          "type": "Dword",
          "value": 1,
          "default": null,
          "valueKind": "Policy"
        },
        {
          "kind": "Registry",
          "hive": "LocalMachine",
          "path": "SOFTWARE\\Policies\\Microsoft\\Windows\\Appx\\RemoveDefaultMicrosoftStorePackages",
          "name": "MicrosoftOfficeHub",
          "type": "Dword",
          "value": 1,
          "default": null,
          "valueKind": "Policy"
        },
        {
          "kind": "Registry",
          "hive": "LocalMachine",
          "path": "SOFTWARE\\Policies\\Microsoft\\Windows\\Appx\\RemoveDefaultMicrosoftStorePackages",
          "name": "MSTeams",
          "type": "Dword",
