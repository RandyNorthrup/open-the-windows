          "default": null,
          "valueKind": "Policy"
        },
        {
          "kind": "Registry",
          "hive": "LocalMachine",
          "path": "SOFTWARE\\Policies\\Microsoft\\Windows\\Appx\\RemoveDefaultMicrosoftStorePackages",
          "name": "GamingApp",
          "type": "Dword",
          "value": 1,
          "default": null,
          "valueKind": "Policy"
        },
        {
          "kind": "Registry",
          "hive": "LocalMachine",
          "path": "SOFTWARE\\Policies\\Microsoft\\Windows\\Appx\\RemoveDefaultMicrosoftStorePackages",
          "name": "XboxGamingOverlay",
          "type": "Dword",
          "value": 1,
