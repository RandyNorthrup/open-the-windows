{
  "$schema": "../schema/tweak.schema.json",
  "entries": [
    {
      "id": "debloat.apps.remove-solitaire-collection",
      "title": "Remove Microsoft Solitaire Collection",
      "description": "Removes the Solitaire Collection app for all users and deprovisions it so new users do not get it.",
      "rationale": "Ad-supported game with no system dependencies; reinstall from the Store at any time.",
      "category": "Debloat",
      "level": "Basic",
      "risk": "Safe",
      "scope": "Machine",
      "status": "Draft",
      "appliesTo": { "editions": [], "minBuild": null, "maxBuild": null, "architectures": [] },
      "actions": [
        {
          "kind": "Appx",
          "packageFamilyName": "Microsoft.MicrosoftSolitaireCollection_8wekyb3d8bbwe",
          "mode": "AllUsersAndDeprovision",
          "reinstallHint": "Microsoft Store: ms-windows-store://pdp/?productid=9WZDNCRFHWD2"
        }
      ],
      "requires": "None",
      "dependsOn": [],
      "conflictsWith": [],
      "managedBy": null,
      "sideEffects": [],
      "sources": [
        "https://learn.microsoft.com/windows/application-management/provisioned-apps-windows-client-os",
        "https://learn.microsoft.com/powershell/module/dism/remove-appxprovisionedpackage"
      ],
      "verifiedOn": [],
      "tags": ["appx", "games"]
    },
    {
      "id": "debloat.apps.remove-feedback-hub",
      "title": "Remove Feedback Hub",
