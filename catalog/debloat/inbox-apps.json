    {
      "id": "debloat.content-delivery.disable-app-suggestions",
      "title": "Stop automatic installation of suggested apps",
      "description": "Turns off Content Delivery Manager features that silently install promoted third-party apps and pin suggestions in Start.",
      "rationale": "These are the Start-menu stubs (streaming, games, social) that appear after setup and after feature updates.",
      "category": "Debloat",
      "level": "Basic",
      "risk": "Safe",
      "scope": "User",
      "status": "Draft",
      "appliesTo": { "editions": [], "minBuild": null, "maxBuild": null, "architectures": [] },
      "actions": [
        {
          "kind": "Registry",
          "hive": "User",
          "path": "Software\\Microsoft\\Windows\\CurrentVersion\\ContentDeliveryManager",
          "name": "SilentInstalledAppsEnabled",
          "type": "Dword",
          "value": 0,
          "default": 1,
          "valueKind": "Preference"
        },
        {
          "kind": "Registry",
          "hive": "User",
          "path": "Software\\Microsoft\\Windows\\CurrentVersion\\ContentDeliveryManager",
          "name": "OemPreInstalledAppsEnabled",
          "type": "Dword",
          "value": 0,
          "default": 1,
          "valueKind": "Preference"
        },
        {
          "kind": "Registry",
          "hive": "User",
          "path": "Software\\Microsoft\\Windows\\CurrentVersion\\ContentDeliveryManager",
          "name": "PreInstalledAppsEnabled",
          "type": "Dword",
          "value": 0,
          "default": 1,
          "valueKind": "Preference"
        },
        {
          "kind": "Registry",
          "hive": "User",
          "path": "Software\\Microsoft\\Windows\\CurrentVersion\\ContentDeliveryManager",
          "name": "SubscribedContent-338388Enabled",
          "type": "Dword",
          "value": 0,
          "default": 1,
          "valueKind": "Preference"
        }
      ],
      "requires": "None",
      "dependsOn": [],
      "conflictsWith": [],
      "managedBy": {
        "policyCsp": "Experience/AllowWindowsConsumerFeatures",
        "groupPolicyPath": "Computer Configuration\\Administrative Templates\\Windows Components\\Cloud Content\\Turn off Microsoft consumer experiences"
      },
      "sideEffects": [],
      "sources": [
        "https://learn.microsoft.com/windows/privacy/manage-connections-from-windows-operating-system-components-to-microsoft-services",
        "https://learn.microsoft.com/windows/client-management/mdm/policy-csp-experience"
      ],
      "verifiedOn": [],
      "tags": ["ads", "start"]
    }
  ]
}
