          "packageFamilyName": "Microsoft.WindowsFeedbackHub_8wekyb3d8bbwe",
          "mode": "AllUsersAndDeprovision",
          "reinstallHint": "Microsoft Store: ms-windows-store://pdp/?productid=9NBLGGH4R32N"
        }
      ],
      "requires": "None",
      "dependsOn": [],
      "conflictsWith": [],
      "managedBy": null,
