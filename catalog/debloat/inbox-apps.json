    {
      "id": "debloat.content-delivery.disable-app-suggestions",
      "title": "Stop automatic installation of suggested apps",
      "description": "Turns off Content Delivery Manager features that silently install promoted third-party apps and pin suggestions in Start.",
      "rationale": "These are the Start-menu stubs (streaming, games, social) that appear after setup and after feature updates.",
      "category": "Debloat",
      "level": "Basic",
      "risk": "Safe",
      "scope": "User",
      "status": "Verified",
      "appliesTo": { "editions": [], "minBuild": null, "maxBuild": null, "architectures": [] },
      "actions": [
        {
          "kind": "Registry",
          "hive": "User",
          "path": "Software\\Microsoft\\Windows\\CurrentVersion\\ContentDeliveryManager",
          "name": "SilentInstalledAppsEnabled",
          "type": "Dword",
          "value": 0,
          "default": 1,
          "valueKind": "Preference"
        },
        {
          "kind": "Registry",
          "hive": "User",
          "path": "Software\\Microsoft\\Windows\\CurrentVersion\\ContentDeliveryManager",
          "name": "OemPreInstalledAppsEnabled",
          "type": "Dword",
          "value": 0,
          "default": 1,
          "valueKind": "Preference"
        },
        {
          "kind": "Registry",
          "hive": "User",
          "path": "Software\\Microsoft\\Windows\\CurrentVersion\\ContentDeliveryManager",
          "name": "PreInstalledAppsEnabled",
          "type": "Dword",
          "value": 0,
          "default": 1,
          "valueKind": "Preference"
        },
        {
          "kind": "Registry",
          "hive": "User",
          "path": "Software\\Microsoft\\Windows\\CurrentVersion\\ContentDeliveryManager",
          "name": "SubscribedContent-338388Enabled",
          "type": "Dword",
          "value": 0,
          "default": 1,
          "valueKind": "Preference"
        }
      ],
      "requires": "None",
      "dependsOn": [],
      "conflictsWith": [],
      "managedBy": {
        "policyCsp": "Experience/AllowWindowsConsumerFeatures",
        "groupPolicyPath": "Computer Configuration\\Administrative Templates\\Windows Components\\Cloud Content\\Turn off Microsoft consumer experiences"
      },
      "sideEffects": [],
      "sources": [
        "https://learn.microsoft.com/windows/privacy/manage-connections-from-windows-operating-system-components-to-microsoft-services",
        "https://learn.microsoft.com/windows/client-management/mdm/policy-csp-experience"
      ],
      "verifiedOn": [
        { "build": 26200, "edition": "Pro", "date": "2026-11-07" }
      ],
      "tags": ["ads", "start"]
    },
    {
      "id": "debloat.apps.remove-candy-crush",
      "title": "Remove Candy Crush Saga",
      "description": "Removes the Candy Crush Saga Store stub for all users and deprovisions it.",
      "rationale": "OEM and Content Delivery often pin this game; it has no system role. If the package is not installed the removal is already the desired state.",
      "category": "Debloat",
      "level": "Basic",
      "risk": "Safe",
      "scope": "Machine",
      "status": "Draft",
      "appliesTo": { "editions": [], "minBuild": null, "maxBuild": null, "architectures": [] },
      "actions": [
        {
          "kind": "Appx",
          "packageFamilyName": "king.com.CandyCrushSaga_kgqvnymyfvs32",
          "mode": "AllUsersAndDeprovision",
          "reinstallHint": "Microsoft Store: search for Candy Crush Saga"
        }
      ],
      "requires": "None",
      "dependsOn": [],
      "conflictsWith": [],
      "managedBy": null,
      "sideEffects": [],
      "sources": [
        "https://github.com/Raphire/Win11Debloat",
        "https://learn.microsoft.com/windows/application-management/provisioned-apps-windows-client-os"
      ],
      "verifiedOn": [],
      "tags": ["appx", "games", "oem"]
    },
