    {
      "id": "privacy.ads.disable-recent-items-tracking",
      "title": "Turn off recent items and jump-list tracking",
      "description": "Stops Windows from recording recently opened documents that feed jump lists and Start's Recommended area.",
      "rationale": "Recency tracking is a local usage log; turning it off trades the recent-files convenience for less on-device history.",
      "category": "Privacy",
      "level": "Balanced",
      "risk": "Caution",
      "scope": "User",
      "status": "Draft",
