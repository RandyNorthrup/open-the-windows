    {
      "id": "privacy.ads.disable-language-list",
      "title": "Stop websites from reading your language list",
      "description": "Sets the Accept-Language opt-out so Windows no longer offers your full language-preference list to websites.",
      "rationale": "The language list is a browser-fingerprinting signal; a single preferred language is still sent, so sites keep working.",
      "category": "Privacy",
      "level": "Basic",
      "risk": "Safe",
      "scope": "User",
      "status": "Draft",
      "appliesTo": {
        "editions": [],
        "minBuild": null,
        "maxBuild": null,
        "architectures": []
      },
      "actions": [
        {
          "kind": "Registry",
          "hive": "User",
          "path": "Control Panel\\International\\User Profile",
          "name": "HttpAcceptLanguageOptOut",
          "type": "Dword",
          "value": 1,
          "default": null,
          "valueKind": "Preference"
        }
      ],
      "requires": "None",
      "dependsOn": [],
      "conflictsWith": [],
      "managedBy": {
        "policyCsp": null,
        "groupPolicyPath": null
      },
      "sideEffects": [
        "Some sites may initially guess the wrong language until you select one."
      ],
      "sources": [
        "https://learn.microsoft.com/en-us/windows/privacy/manage-connections-from-windows-operating-system-components-to-microsoft-services"
      ],
      "verifiedOn": [],
      "tags": [
        "ads",
        "tracking"
      ]
    },
    {
      "id": "privacy.ads.disable-app-launch-tracking",
      "title": "Turn off app-launch tracking for Start and search",
      "description": "Stops Windows from tracking which apps you launch to rank Start menu and search results.",
      "rationale": "The data stays local, but the ranking signal is pure convenience; disabling it removes an on-device activity log with no functional loss.",
      "category": "Privacy",
      "level": "Basic",
      "risk": "Safe",
      "scope": "User",
      "status": "Draft",
      "appliesTo": {
        "editions": [],
