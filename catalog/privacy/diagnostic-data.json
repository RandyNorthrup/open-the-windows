    {
      "id": "privacy.feedback.disable-notifications",
      "title": "Turn off feedback requests",
      "description": "Stops Windows from asking for feedback (the Feedback Hub prompts) and disables the feedback notification policy.",
      "rationale": "Feedback prompts are interruptions that upload usage context; nothing depends on them.",
      "category": "Privacy",
      "level": "Basic",
      "risk": "Safe",
      "scope": "Machine",
      "status": "Verified",
      "appliesTo": {
        "editions": [],
        "minBuild": null,
        "maxBuild": null,
        "architectures": []
      },
      "actions": [
        {
          "kind": "Registry",
          "hive": "LocalMachine",
          "path": "SOFTWARE\\Policies\\Microsoft\\Windows\\DataCollection",
          "name": "DoNotShowFeedbackNotifications",
          "type": "Dword",
          "value": 1,
          "default": null,
          "valueKind": "Policy"
        }
      ],
      "requires": "None",
      "dependsOn": [],
      "conflictsWith": [],
      "managedBy": {
        "policyCsp": "Experience/DoNotShowFeedbackNotifications",
        "groupPolicyPath": "Computer Configuration\\Administrative Templates\\Windows Components\\Data Collection and Preview Builds\\Do not show feedback notifications"
      },
      "sideEffects": [],
      "sources": [
        "https://learn.microsoft.com/windows/client-management/mdm/policy-csp-experience"
      ],
