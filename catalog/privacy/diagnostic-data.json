  "$schema": "../schema/tweak.schema.json",
  "entries": [
    {
      "id": "privacy.diagnostic-data.required-only",
      "title": "Limit diagnostic data to Required",
      "description": "Sets the diagnostic data policy to Required (formerly Basic) so Windows sends only the data needed to keep the device secure and up to date, instead of Optional data (app usage, browsing, inking and typing).",
      "rationale": "Required is the lowest level honoured on Home and Pro; 'Diagnostic data off' (0) is only honoured on Enterprise, Education and IoT. Windows Update, Defender and Store keep working at Required.",
      "category": "Privacy",
      "level": "Basic",
      "risk": "Safe",
      "scope": "Machine",
      "status": "Verified",
      "appliesTo": {
        "editions": [],
        "minBuild": null,
        "maxBuild": null,
        "architectures": []
      },
      "actions": [
        {
          "kind": "Registry",
          "hive": "LocalMachine",
          "path": "SOFTWARE\\Policies\\Microsoft\\Windows\\DataCollection",
          "name": "AllowTelemetry",
          "type": "Dword",
          "value": 1,
          "default": null,
          "valueKind": "Policy"
        }
      ],
      "requires": "None",
      "dependsOn": [],
      "conflictsWith": [],
      "managedBy": {
        "policyCsp": "System/AllowTelemetry",
        "groupPolicyPath": "Computer Configuration\\Administrative Templates\\Windows Components\\Data Collection and Preview Builds\\Allow Diagnostic Data"
      },
      "sideEffects": [],
      "sources": [
        "https://learn.microsoft.com/windows/privacy/configure-windows-diagnostic-data-in-your-organization",
        "https://learn.microsoft.com/windows/client-management/mdm/policy-csp-system"
      ],
      "verifiedOn": [
        {
          "build": 26200,
          "edition": "Pro",
          "date": "2026-08-17",
          "evidence": "docs/certification/M4/machine-scope-verification.md"
        }
      ],
      "tags": [
        "telemetry"
      ]
    },
    {
      "id": "privacy.diagnostic-data.limit-log-collection",
      "title": "Do not upload diagnostic logs and memory dumps",
      "description": "Prevents Windows from uploading additional diagnostic logs and crash memory dumps as part of diagnostic data.",
      "rationale": "Logs and dumps can contain file names, paths and memory contents; they are not needed for updates or security.",
      "category": "Privacy",
      "level": "Basic",
      "risk": "Safe",
      "scope": "Machine",
      "status": "Verified",
      "appliesTo": {
        "editions": [],
        "minBuild": null,
        "maxBuild": null,
        "architectures": []
      },
      "actions": [
        {
          "kind": "Registry",
          "hive": "LocalMachine",
          "path": "SOFTWARE\\Policies\\Microsoft\\Windows\\DataCollection",
          "name": "LimitDiagnosticLogCollection",
          "type": "Dword",
          "value": 1,
          "default": null,
          "valueKind": "Policy"
        },
        {
          "kind": "Registry",
          "hive": "LocalMachine",
          "path": "SOFTWARE\\Policies\\Microsoft\\Windows\\DataCollection",
          "name": "LimitDumpCollection",
          "type": "Dword",
          "value": 1,
          "default": null,
          "valueKind": "Policy"
        }
      ],
      "requires": "None",
      "dependsOn": [],
      "conflictsWith": [],
      "managedBy": {
        "policyCsp": "System/LimitDiagnosticLogCollection",
        "groupPolicyPath": "Computer Configuration\\Administrative Templates\\Windows Components\\Data Collection and Preview Builds"
      },
      "sideEffects": [],
      "sources": [
        "https://learn.microsoft.com/windows/client-management/mdm/policy-csp-system"
