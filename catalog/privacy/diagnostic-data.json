    {
      "id": "privacy.recall.disable",
      "title": "Disable Windows Recall",
      "description": "Sets the WindowsAI policy that disables Recall snapshots (Copilot+ PCs) so no screen history is captured or analysed.",
      "rationale": "Recall stores continuous screenshots of activity; even encrypted, it is an unwanted data store for privacy-focused and managed devices. The policy is harmless on devices without Recall.",
      "category": "Privacy",
      "level": "Basic",
      "risk": "Safe",
      "scope": "Machine",
      "status": "Verified",
      "appliesTo": {
        "editions": [],
        "minBuild": 26100,
        "maxBuild": null,
        "architectures": []
      },
      "actions": [
        {
          "kind": "Registry",
          "hive": "LocalMachine",
          "path": "SOFTWARE\\Policies\\Microsoft\\Windows\\WindowsAI",
          "name": "DisableAIDataAnalysis",
          "type": "Dword",
          "value": 1,
          "default": null,
          "valueKind": "Policy"
        }
      ],
      "requires": "None",
      "dependsOn": [],
      "conflictsWith": [],
      "managedBy": {
        "policyCsp": "WindowsAI/DisableAIDataAnalysis",
        "groupPolicyPath": "Computer Configuration\\Administrative Templates\\Windows Components\\Windows AI\\Turn off saving snapshots for Windows"
      },
      "sideEffects": [
        "Recall and its timeline are unavailable."
      ],
      "sources": [
        "https://learn.microsoft.com/windows/client-management/mdm/policy-csp-windowsai",
        "https://learn.microsoft.com/windows/client-management/manage-recall"
      ],
      "verifiedOn": [
