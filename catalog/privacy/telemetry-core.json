      "id": "privacy.wer.no-auto-approve-os-dumps",
      "title": "Do not auto-approve sending OS crash dumps",
      "description": "Ensures the Windows Error Reporting policy that would automatically send operating-system crash dumps is not enabled.",
      "rationale": "Keeps OS dumps from being sent without consent. This is the private default; the entry ensures it is not overridden.",
      "category": "Privacy",
      "level": "Basic",
      "risk": "Safe",
