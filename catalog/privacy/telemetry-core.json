        }
      ],
      "tags": [
        "telemetry",
        "notifications"
      ]
    },
    {
      "id": "privacy.diagnostics.device-name",
      "title": "Do not send device name in diagnostic data",
      "description": "Sets the policy that keeps the device name out of diagnostic data (the private default), so a tool cannot turn it on unnoticed.",
      "rationale": "Sending the device name is off by default; this entry ensures it stays off. Windows Update for Business reports show device names only when it is enabled.",
      "category": "Privacy",
      "level": "Basic",
      "risk": "Safe",
      "scope": "Machine",
      "status": "Verified",
      "appliesTo": {
        "editions": [
          "Pro",
          "Enterprise",
          "Education"
        ],
        "minBuild": null,
        "maxBuild": null,
        "architectures": []
      },
      "actions": [
        {
          "kind": "Registry",
          "hive": "LocalMachine",
          "path": "SOFTWARE\\Policies\\Microsoft\\Windows\\DataCollection",
          "name": "AllowDeviceNameInDiagnosticData",
          "type": "Dword",
          "value": 0,
          "default": null,
          "valueKind": "Policy"
        }
      ],
      "requires": "None",
      "dependsOn": [],
      "conflictsWith": [],
      "managedBy": {
        "policyCsp": "System/AllowDeviceNameInDiagnosticData",
        "groupPolicyPath": null
      },
      "sideEffects": [],
      "sources": [
        "https://learn.microsoft.com/en-us/windows/client-management/mdm/policy-csp-system",
        "https://learn.microsoft.com/en-us/windows/deployment/update/wufb-reports-prerequisites"
      ],
      "verifiedOn": [
        {
          "build": 26200,
          "edition": "Pro",
          "date": "2026-08-17"
        }
      ],
      "tags": [
        "telemetry",
        "device-name"
      ]
    },
    {
      "id": "privacy.diagnostics.disable-onesettings",
      "title": "Disable OneSettings downloads",
      "description": "Sets the policy that stops Windows from downloading configuration from the OneSettings remote configuration service.",
      "rationale": "OneSettings periodically fetches remote configuration. Disabling it is a paranoid, last-resort measure: Microsoft warns that apps using the service may stop working and Windows Update for Business reports may be incorrect. It does not stop diagnostic uploads.",
      "category": "Privacy",
      "level": "Paranoid",
      "risk": "Breaking",
      "scope": "Machine",
      "status": "Draft",
      "appliesTo": {
        "editions": [
          "Pro",
          "Enterprise",
          "Education"
        ],
        "minBuild": null,
        "maxBuild": null,
        "architectures": []
      },
      "actions": [
        {
          "kind": "Registry",
          "hive": "LocalMachine",
          "path": "SOFTWARE\\Policies\\Microsoft\\Windows\\DataCollection",
          "name": "DisableOneSettingsDownloads",
          "type": "Dword",
          "value": 1,
          "default": null,
          "valueKind": "Policy"
        }
      ],
      "requires": "None",
      "dependsOn": [],
      "conflictsWith": [],
      "managedBy": {
        "policyCsp": "System/DisableOneSettingsDownloads",
        "groupPolicyPath": null
      },
      "sideEffects": [
        "Microsoft warns that apps using the OneSettings service may stop working.",
        "Windows Update for Business reports data may be incorrect or missing.",
        "Does not stop diagnostic data uploads."
      ],
      "sources": [
        "https://learn.microsoft.com/en-us/windows/privacy/manage-connections-from-windows-operating-system-components-to-microsoft-services",
        "https://learn.microsoft.com/en-us/windows/client-management/mdm/policy-csp-system",
        "https://learn.microsoft.com/en-us/windows/deployment/update/wufb-reports-prerequisites"
      ],
      "verifiedOn": [],
      "tags": [
        "telemetry",
        "onesettings"
      ]
    },
    {
      "id": "privacy.diagnostics.onesettings-auditing",
      "title": "Audit OneSettings connection attempts",
      "description": "Enables the policy that logs OneSettings connection attempts to the Microsoft-Windows-Privacy-Auditing/Operational event log.",
      "rationale": "A transparency feature that records when Windows contacts the OneSettings service; useful for auditing what phones home. It does not block any connection.",
      "category": "Privacy",
      "level": "Basic",
      "risk": "Safe",
      "scope": "Machine",
      "status": "Verified",
      "appliesTo": {
        "editions": [
          "Pro",
          "Enterprise",
          "Education"
        ],
        "minBuild": null,
        "maxBuild": null,
        "architectures": []
      },
      "actions": [
        {
          "kind": "Registry",
          "hive": "LocalMachine",
          "path": "SOFTWARE\\Policies\\Microsoft\\Windows\\DataCollection",
          "name": "EnableOneSettingsAuditing",
          "type": "Dword",
          "value": 1,
          "default": null,
          "valueKind": "Policy"
        }
      ],
      "requires": "None",
      "dependsOn": [],
      "conflictsWith": [],
      "managedBy": {
        "policyCsp": "System/EnableOneSettingsAuditing",
        "groupPolicyPath": null
      },
      "sideEffects": [],
      "sources": [
        "https://learn.microsoft.com/en-us/windows/client-management/mdm/policy-csp-system"
      ],
      "verifiedOn": [
        {
          "build": 26200,
          "edition": "Pro",
          "date": "2026-08-17"
        }
      ],
      "tags": [
        "telemetry",
        "onesettings",
        "audit"
      ]
    },
    {
      "id": "privacy.diagnostics.privacy-experience",
      "title": "Skip the first-logon privacy settings experience (OOBE)",
      "description": "Sets the policy that skips the out-of-box / first-logon privacy settings page so users are not prompted to configure privacy options.",
      "rationale": "Intended for managed or automated deployments where the privacy toggles are configured centrally. Because users are not asked, the individual privacy settings must be applied separately.",
      "category": "Privacy",
      "level": "Strict",
      "risk": "Caution",
      "scope": "Machine",
      "status": "Draft",
      "appliesTo": {
        "editions": [
          "Pro",
          "Enterprise",
          "Education"
        ],
        "minBuild": null,
        "maxBuild": null,
        "architectures": []
      },
      "actions": [
        {
          "kind": "Registry",
          "hive": "LocalMachine",
          "path": "SOFTWARE\\Policies\\Microsoft\\Windows\\OOBE",
          "name": "DisablePrivacyExperience",
          "type": "Dword",
          "value": 1,
          "default": null,
          "valueKind": "Policy"
        }
      ],
      "requires": "None",
      "dependsOn": [],
      "conflictsWith": [],
      "managedBy": {
        "policyCsp": "Privacy/DisablePrivacyExperience",
        "groupPolicyPath": null
      },
      "sideEffects": [
        "Users are not shown the first-logon privacy settings page, so the individual privacy toggles must be configured separately."
      ],
      "sources": [
        "https://learn.microsoft.com/en-us/windows/client-management/mdm/policy-csp-privacy"
      ],
      "verifiedOn": [],
      "tags": [
        "oobe",
        "privacy-experience"
      ]
    },
    {
