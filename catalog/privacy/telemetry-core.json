      "description": "Sets the Application Compatibility policy that turns off the Inventory Collector, which sends application, device and driver inventory to Microsoft as part of Appraiser.",
      "rationale": "Stops inventory data being sent to Microsoft. Microsoft notes inventory feeds app-compatibility decisions, so this can reduce feature-update compatibility evaluation quality.",
      "category": "Privacy",
      "level": "Balanced",
      "risk": "Caution",
      "scope": "Machine",
      "status": "Verified",
      "appliesTo": {
        "editions": [
          "Pro",
          "Enterprise",
          "Education"
        ],
        "minBuild": null,
        "maxBuild": null,
        "architectures": []
      },
      "actions": [
        {
          "kind": "Registry",
          "hive": "LocalMachine",
          "path": "SOFTWARE\\Policies\\Microsoft\\Windows\\AppCompat",
          "name": "DisableInventory",
          "type": "Dword",
          "value": 1,
          "default": null,
          "valueKind": "Policy"
        }
      ],
      "requires": "None",
      "dependsOn": [],
      "conflictsWith": [],
      "managedBy": {
        "policyCsp": "ADMX_AppCompat/AppCompatTurnOffProgramInventory",
        "groupPolicyPath": null
      },
      "sideEffects": [
        "Can reduce the quality of feature-update compatibility evaluation (safeguard holds); impact on Windows 11 is not fully verified."
      ],
      "sources": [
        "https://learn.microsoft.com/en-us/windows/client-management/mdm/policy-csp-admx-appcompat"
      ],
      "verifiedOn": [
        {
          "build": 26200,
          "edition": "Pro",
          "date": "2026-08-17"
        }
      ],
      "tags": [
        "telemetry",
        "appcompat",
        "inventory"
      ]
    },
