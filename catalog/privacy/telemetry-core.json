      "description": "Sets the SIUF feedback frequency values (NumberOfSIUFInPeriod and PeriodInNanoSeconds) to 0 so Windows never asks the current user for feedback.",
      "rationale": "Stops Feedback Hub prompts for the current user. Deleting both values restores the automatic frequency.",
      "category": "Privacy",
      "level": "Basic",
      "risk": "Safe",
      "scope": "User",
      "status": "Draft",
      "appliesTo": {
        "editions": [],
        "minBuild": null,
        "maxBuild": null,
        "architectures": []
      },
      "actions": [
        {
          "kind": "Registry",
          "hive": "User",
          "path": "Software\\Microsoft\\Siuf\\Rules",
          "name": "NumberOfSIUFInPeriod",
          "type": "Dword",
          "value": 0,
          "default": null,
          "valueKind": "Preference"
        },
        {
          "kind": "Registry",
          "hive": "User",
          "path": "Software\\Microsoft\\Siuf\\Rules",
          "name": "PeriodInNanoSeconds",
          "type": "Dword",
          "value": 0,
          "default": null,
          "valueKind": "Preference"
        }
      ],
      "requires": "None",
      "dependsOn": [],
      "conflictsWith": [],
