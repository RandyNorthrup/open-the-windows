{
  "$schema": "../schema/tweak.schema.json",
  "entries": [
    {
      "id": "privacy.diagnostics.disable-autologgers",
      "title": "Disable the DiagTrack ETW autologgers",
      "description": "Sets the Start value of the AutoLogger-Diagtrack-Listener and SQMLogger ETW autologger sessions to 0 so the DiagTrack and CEIP kernel trace sessions do not start at boot.",
      "rationale": "Removes the low-level trace sessions that feed diagnostic and CEIP telemetry. Redundant once diagnostic data is Required and CEIP is off; the writes are unsupported and may be reset by cumulative updates.",
      "category": "Privacy",
      "level": "Paranoid",
      "risk": "Advanced",
      "scope": "Machine",
      "status": "Draft",
      "appliesTo": {
        "editions": [],
        "minBuild": null,
        "maxBuild": null,
        "architectures": []
      },
      "actions": [
        {
          "kind": "Registry",
          "hive": "LocalMachine",
          "path": "SYSTEM\\CurrentControlSet\\Control\\WMI\\Autologger\\AutoLogger-Diagtrack-Listener",
          "name": "Start",
          "type": "Dword",
          "value": 0,
          "default": 1,
          "valueKind": "Preference"
        },
        {
          "kind": "Registry",
          "hive": "LocalMachine",
          "path": "SYSTEM\\CurrentControlSet\\Control\\WMI\\Autologger\\SQMLogger",
          "name": "Start",
          "type": "Dword",
          "value": 0,
          "default": 1,
          "valueKind": "Preference"
        }
      ],
      "requires": "Reboot",
      "dependsOn": [],
      "conflictsWith": [],
      "managedBy": {
        "policyCsp": null,
        "groupPolicyPath": null
      },
      "sideEffects": [
        "Redundant once diagnostic data is Required and CEIP is off.",
        "Unsupported; cumulative updates may reset the autologger start values.",
        "Microsoft documents the behaviour but not this exact registry value; community-verified (privacy.sexy / Sophia / winutil)."
      ],
      "sources": [
        "https://github.com/undergroundwires/privacy.sexy",
        "https://github.com/ChrisTitusTech/winutil"
      ],
      "verifiedOn": [],
      "tags": [
        "telemetry",
        "diagtrack",
        "etw",
        "unverified-ms"
      ]
    },
    {
      "id": "privacy.diagnostics.optin-change-notification",
      "title": "Suppress diagnostic data setting change notifications",
      "description": "Sets the policy that stops Windows from showing notifications when the diagnostic data setting changes.",
      "rationale": "Removes an interruption notification. It does not change what diagnostic data is collected.",
      "category": "Privacy",
      "level": "Balanced",
      "risk": "Safe",
      "scope": "Machine",
      "status": "Verified",
      "appliesTo": {
        "editions": [
          "Pro",
          "Enterprise",
          "Education"
        ],
        "minBuild": null,
        "maxBuild": null,
        "architectures": []
      },
      "actions": [
        {
          "kind": "Registry",
          "hive": "LocalMachine",
          "path": "SOFTWARE\\Policies\\Microsoft\\Windows\\DataCollection",
          "name": "DisableTelemetryOptInChangeNotification",
          "type": "Dword",
          "value": 1,
          "default": null,
          "valueKind": "Policy"
        }
      ],
      "requires": "None",
      "dependsOn": [],
      "conflictsWith": [],
      "managedBy": {
        "policyCsp": "System/ConfigureTelemetryOptInChangeNotification",
        "groupPolicyPath": null
      },
      "sideEffects": [],
      "sources": [
        "https://learn.microsoft.com/en-us/windows/client-management/mdm/policy-csp-system"
      ],
      "verifiedOn": [
