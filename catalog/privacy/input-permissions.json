    {
      "id": "privacy.input.improve-inking-typing-off",
      "title": "Turn off Improve inking and typing",
      "description": "Disables the Diagnostics & feedback setting that sends samples of typed and handwritten text to Microsoft to improve recognition.",
      "rationale": "Keystroke and ink samples are among the most sensitive telemetry; local typing and handwriting are unaffected. Microsoft documents the toggle but not this exact key.",
      "category": "Privacy",
      "level": "Basic",
      "risk": "Safe",
      "scope": "User",
      "status": "Draft",
      "appliesTo": {
        "editions": [],
        "minBuild": null,
        "maxBuild": null,
        "architectures": []
      },
      "actions": [
        {
          "kind": "Registry",
          "hive": "User",
          "path": "Software\\Microsoft\\Input\\TIPC",
          "name": "Enabled",
          "type": "Dword",
          "value": 0,
          "default": null,
          "valueKind": "Preference"
        }
      ],
      "requires": "None",
      "dependsOn": [],
      "conflictsWith": [],
      "managedBy": {
        "policyCsp": null,
        "groupPolicyPath": null
      },
      "sideEffects": [
        "Microsoft documents the behaviour but not this exact registry value; community-verified (privacy.sexy / Win11Debloat / winutil)."
      ],
      "sources": [
        "https://learn.microsoft.com/en-us/windows/privacy/manage-connections-from-windows-operating-system-components-to-microsoft-services",
        "https://github.com/undergroundwires/privacy.sexy",
        "https://github.com/Raphire/Win11Debloat"
      ],
      "verifiedOn": [],
      "tags": [
        "input",
        "typing",
        "unverified-ms"
      ]
    },
