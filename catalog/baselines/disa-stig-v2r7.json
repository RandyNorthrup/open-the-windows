{
  "$schema": "https://github.com/RandyNorthrup/open-the-windows/catalog/schema/baseline.schema.json",
  "schemaVersion": 1,
  "id": "disa-stig-v2r7",
  "title": "DISA Microsoft Windows 11 STIG V2R7",
  "rules": [
    { "ruleId": "V-253286", "title": "Disable the SMBv1 protocol on the system to remove the legacy, exploitable file-sharing stack.", "severity": "CAT II", "tweakIds": ["security.network.remove-smbv1"], "sources": ["https://cyber.trackr.live/stig/Windows_11/2/7", "https://www.cyber.mil/stigs/downloads/"] },
    { "ruleId": "V-253451", "title": "Require the SMB server to always digitally sign communications to resist tampering and relay attacks.", "severity": "CAT II", "tweakIds": ["security.network.require-smb-signing"], "sources": ["https://cyber.trackr.live/stig/Windows_11/2/7", "https://www.cyber.mil/stigs/downloads/"] },
    { "ruleId": "V-253370", "title": "Run Credential Guard so domain credentials are isolated inside virtualization-based security.", "severity": "CAT I", "tweakIds": ["security.credentials.credential-guard"], "sources": ["https://cyber.trackr.live/stig/Windows_11/2/7", "https://www.cyber.mil/stigs/downloads/"] },
    { "ruleId": "V-253369", "title": "Enable virtualization-based security with the platform security level set to Secure Boot (or Secure Boot with DMA).", "severity": "CAT II", "tweakIds": ["security.credentials.virtualization-based-security"], "sources": ["https://cyber.trackr.live/stig/Windows_11/2/7", "https://www.cyber.mil/stigs/downloads/"] },
    { "ruleId": "V-253358", "title": "Disable WDigest authentication so plaintext credentials are not retained in memory.", "severity": "CAT II", "tweakIds": ["security.credentials.wdigest-cleartext"], "sources": ["https://cyber.trackr.live/stig/Windows_11/2/7", "https://www.cyber.mil/stigs/downloads/"] },
    { "ruleId": "V-253462", "title": "Set the LAN Manager authentication level to send NTLMv2 only and refuse LM and NTLM.", "severity": "CAT I", "tweakIds": ["security.credentials.lan-manager-auth-level"], "sources": ["https://cyber.trackr.live/stig/Windows_11/2/7", "https://www.cyber.mil/stigs/downloads/"] },
    { "ruleId": "V-253461", "title": "Prevent the system from storing the weak LAN Manager hash of user passwords.", "severity": "CAT I", "tweakIds": ["security.credentials.no-lm-hash"], "sources": ["https://cyber.trackr.live/stig/Windows_11/2/7", "https://www.cyber.mil/stigs/downloads/"] },
    { "ruleId": "V-253474", "title": "Run all administrators in Admin Approval Mode so UAC is enforced for elevated actions.", "severity": "CAT II", "tweakIds": ["security.uac.enable-admin-approval-mode"], "sources": ["https://cyber.trackr.live/stig/Windows_11/2/7", "https://www.cyber.mil/stigs/downloads/"] },
    { "ruleId": "V-253411", "title": "Disable the Windows Installer 'always install with elevated privileges' behavior.", "severity": "CAT I", "tweakIds": ["security.installer.disable-always-install-elevated"], "sources": ["https://cyber.trackr.live/stig/Windows_11/2/7", "https://www.cyber.mil/stigs/downloads/"] },
    { "ruleId": "V-253388", "title": "Turn off Autoplay for all drives to block automatic execution from removable and network media.", "severity": "CAT I", "tweakIds": ["security.autoplay.disable-autorun"], "sources": ["https://cyber.trackr.live/stig/Windows_11/2/7", "https://www.cyber.mil/stigs/downloads/"] },
    { "ruleId": "V-253414", "title": "Enable PowerShell script block logging for visibility into executed script content.", "severity": "CAT II", "tweakIds": ["security.powershell.script-block-logging"], "sources": ["https://cyber.trackr.live/stig/Windows_11/2/7", "https://www.cyber.mil/stigs/downloads/"] },
    { "ruleId": "V-253382", "title": "Do not allow solicited Remote Assistance connections to the workstation.", "severity": "CAT I", "tweakIds": ["security.remote.disable-remote-assistance"], "sources": ["https://cyber.trackr.live/stig/Windows_11/2/7", "https://www.cyber.mil/stigs/downloads/"] },
    { "ruleId": "V-253393", "title": "Prevent the Windows telemetry / diagnostic-data level from being configured to Full.", "severity": "CAT II", "tweakIds": ["privacy.diagnostic-data.required-only"], "sources": ["https://cyber.trackr.live/stig/Windows_11/2/7", "https://www.cyber.mil/stigs/downloads/"] },
    { "ruleId": "V-253281", "title": "Ensure a host-based firewall is installed and enabled on the system.", "severity": "CAT II", "tweakIds": ["security.firewall.enable-all-profiles"], "sources": ["https://cyber.trackr.live/stig/Windows_11/2/7", "https://www.cyber.mil/stigs/downloads/"] },
    { "ruleId": "V-253257", "title": "Require UEFI Secure Boot to be enabled on the system.", "severity": "CAT II", "tweakIds": [], "checkOnly": { "healthCheckId": "boot.secure-boot" }, "sources": ["https://cyber.trackr.live/stig/Windows_11/2/7", "https://www.cyber.mil/stigs/downloads/"] },
    { "ruleId": "V-253259", "title": "Require BitLocker to encrypt drives so information at rest is protected.", "severity": "CAT I", "tweakIds": [], "checkOnly": { "healthCheckId": "bitlocker.os-volume" }, "sources": ["https://cyber.trackr.live/stig/Windows_11/2/7", "https://www.cyber.mil/stigs/downloads/"] }
  ]
}
