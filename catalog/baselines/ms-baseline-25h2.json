{
  "$schema": "https://github.com/RandyNorthrup/open-the-windows/catalog/schema/baseline.schema.json",
  "schemaVersion": 1,
  "id": "ms-baseline-25h2",
  "title": "Microsoft Windows 11 Security Baseline (25H2)",
  "rules": [
    { "ruleId": "MSS-SMBv1-Server-Disabled", "title": "Baseline disables the SMB v1 server component.", "severity": "Baseline", "tweakIds": ["security.network.remove-smbv1"], "sources": ["https://learn.microsoft.com/en-us/intune/device-security/security-baselines/ref-windows-mdm-settings"] },
    { "ruleId": "MSS-LSA-ProtectedProcess-Enabled-UEFILock", "title": "Baseline runs LSA as a protected process with UEFI lock to block credential theft.", "severity": "Baseline", "tweakIds": ["security.credentials.lsa-protection"], "sources": ["https://learn.microsoft.com/en-us/intune/device-security/security-baselines/ref-windows-mdm-settings"] },
    { "ruleId": "MSS-CredentialGuard-Enabled-UEFILock", "title": "Baseline enables Credential Guard with UEFI lock.", "severity": "Baseline", "tweakIds": ["security.credentials.credential-guard", "security.credentials.credential-guard-uefi-lock"], "sources": ["https://learn.microsoft.com/en-us/intune/device-security/security-baselines/ref-windows-mdm-settings"] },
    { "ruleId": "MSS-LANManagerAuthLevel-NTLMv2-RefuseLMandNTLM", "title": "Baseline sets LAN Manager authentication to NTLMv2 only and refuses LM and NTLM.", "severity": "Baseline", "tweakIds": ["security.credentials.lan-manager-auth-level"], "sources": ["https://learn.microsoft.com/en-us/intune/device-security/security-baselines/ref-windows-mdm-settings"] },
    { "ruleId": "MSS-DoNotStoreLANManagerHash-Enabled", "title": "Baseline prevents storage of the LAN Manager hash on password change.", "severity": "Baseline", "tweakIds": ["security.credentials.no-lm-hash"], "sources": ["https://learn.microsoft.com/en-us/intune/device-security/security-baselines/ref-windows-mdm-settings"] },
    { "ruleId": "MSS-NTLMSSP-MinSessionSecurity-Require128BitEncryption", "title": "Baseline requires NTLM and 128-bit encryption for NTLMSSP clients and servers.", "severity": "Baseline", "tweakIds": ["security.credentials.ntlm-min-session-security"], "sources": ["https://learn.microsoft.com/en-us/intune/device-security/security-baselines/ref-windows-mdm-settings"] },
    { "ruleId": "MSS-UAC-RunAllAdminsInAdminApprovalMode-Enabled", "title": "Baseline runs all administrators in Admin Approval Mode.", "severity": "Baseline", "tweakIds": ["security.uac.enable-admin-approval-mode"], "sources": ["https://learn.microsoft.com/en-us/intune/device-security/security-baselines/ref-windows-mdm-settings"] },
    { "ruleId": "MSS-UAC-ElevationPromptForAdmins-ConsentOnSecureDesktop", "title": "Baseline prompts administrators for consent on the secure desktop when elevating.", "severity": "Baseline", "tweakIds": ["security.uac.admin-consent-prompt", "security.uac.secure-desktop-prompt"], "sources": ["https://learn.microsoft.com/en-us/intune/device-security/security-baselines/ref-windows-mdm-settings"] },
    { "ruleId": "MSS-Defender-RealtimeMonitoring-Allowed", "title": "Baseline keeps Microsoft Defender real-time monitoring enabled.", "severity": "Baseline", "tweakIds": ["security.defender.real-time-protection"], "sources": ["https://learn.microsoft.com/en-us/intune/device-security/security-baselines/ref-windows-mdm-settings"] },
    { "ruleId": "MSS-Defender-CloudProtection-Allowed", "title": "Baseline enables Microsoft Defender cloud-delivered protection.", "severity": "Baseline", "tweakIds": ["security.defender.cloud-protection"], "sources": ["https://learn.microsoft.com/en-us/intune/device-security/security-baselines/ref-windows-mdm-settings"] },
    { "ruleId": "MSS-Defender-PUAProtection-Block", "title": "Baseline turns on potentially-unwanted-application protection in block mode.", "severity": "Baseline", "tweakIds": ["security.defender.pua-protection"], "sources": ["https://learn.microsoft.com/en-us/intune/device-security/security-baselines/ref-windows-mdm-settings"] },
    { "ruleId": "MSS-Defender-NetworkProtection-EnabledBlockMode", "title": "Baseline enables Microsoft Defender network protection in block mode.", "severity": "Baseline", "tweakIds": ["security.defender.network-protection-block"], "sources": ["https://learn.microsoft.com/en-us/intune/device-security/security-baselines/ref-windows-mdm-settings"] },
    { "ruleId": "MSS-Defender-ASR-Rules-Block", "title": "Baseline sets core Attack Surface Reduction rules to block.", "severity": "Baseline", "tweakIds": ["security.asr.lsass", "security.asr.office-child-process", "security.asr.office-macro-win32", "security.asr.email-executable", "security.asr.obfuscated-scripts"], "sources": ["https://learn.microsoft.com/en-us/intune/device-security/security-baselines/ref-windows-mdm-settings"] },
    { "ruleId": "MSS-BitLocker-DenyWriteRemovableDrives-Enabled", "title": "Baseline denies write access to removable drives not protected by BitLocker.", "severity": "Baseline", "tweakIds": ["security.media.bitlocker-deny-write-removable"], "sources": ["https://learn.microsoft.com/en-us/intune/device-security/security-baselines/ref-windows-mdm-settings"] },
    { "ruleId": "MSS-Autoplay-TurnOff-AllDrives", "title": "Baseline turns off Autoplay and blocks AutoRun commands on all drives.", "severity": "Baseline", "tweakIds": ["security.autoplay.disable-autorun"], "sources": ["https://learn.microsoft.com/en-us/intune/device-security/security-baselines/ref-windows-mdm-settings"] },
    { "ruleId": "MSS-PowerShell-ScriptBlockLogging-Enabled", "title": "Baseline enables PowerShell script block logging.", "severity": "Baseline", "tweakIds": ["security.powershell.script-block-logging"], "sources": ["https://learn.microsoft.com/en-us/intune/device-security/security-baselines/ref-windows-mdm-settings"] }
  ]
}
