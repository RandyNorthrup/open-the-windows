# Normalise line endings: LF in the repo, native on checkout, except where
# Windows tooling requires CRLF.
* text=auto eol=lf

# Windows-only scripts and solution files keep CRLF so PowerShell / VS behave.
*.ps1  text eol=crlf
*.psm1 text eol=crlf
*.psd1 text eol=crlf
*.cmd  text eol=crlf
*.bat  text eol=crlf
*.sln  text eol=crlf
*.slnx text eol=crlf

# Source
*.cs      text diff=csharp
*.csproj  text
*.props   text
*.targets text
*.xaml    text
*.json    text
*.jsonc   text
*.md      text diff=markdown
*.yml     text
*.yaml    text
*.wxs     text
*.wxi     text
*.wxl     text
*.editorconfig text

# Binary
*.png  binary
*.ico  binary
*.jpg  binary
*.gif  binary
*.snk  binary
*.pfx  binary
*.dll  binary
*.exe  binary
*.msi  binary
*.zip  binary
