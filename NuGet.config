<?xml version="1.0" encoding="utf-8"?>
<!--
  Open The Windows — NuGet configuration.
  Single trusted source (nuget.org), package-source mapping so nothing can be
  pulled from an unexpected feed, and no signature-validation surprises.
  NuGetAudit settings live in Directory.Build.props.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
  <config>
    <add key="signatureValidationMode" value="accept" />
  </config>
</configuration>
