# Open the Windows - developer environment variables.
# The PRODUCT reads no environment variables at runtime (no telemetry, no
# remote config). These are only for the lab-VM helper (build/vm.ps1).
# Copy to .env (gitignored) and fill in; never commit real values.

# Windows 11 lab VM reachable over SSH (Windows OpenSSH server, key auth).
OTW_VM_HOST=10.0.0.10
OTW_VM_USER=<your-vm-admin-user>
# Private key path; default is temp/ssh/otw_vm_ed25519 (temp/ is gitignored).
OTW_VM_KEY=temp/ssh/otw_vm_ed25519
